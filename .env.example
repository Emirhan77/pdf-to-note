# Flask
FLASK_SECRET_KEY=change-this-local-secret
FLASK_DEBUG=1

# LLM provider options: local_ollama, openai, prompt_export
LLM_PROVIDER=local_ollama

# Ollama local mode
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT=420
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=3072
OLLAMA_TEMPERATURE=0.2
LLM_MAX_SOURCE_CHARS=9000

# OpenAI mode, optional
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Cloud storage options: local, aws_s3
CLOUD_STORAGE_PROVIDER=local
AWS_S3_BUCKET=
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_KEY_PREFIX=uploads
AWS_PRESIGNED_URL_EXPIRES=604800
